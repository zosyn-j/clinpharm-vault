    "outcomesModule": {
      "primaryOutcomes": [
        {
          "measure": "Part A and Part B: Number of Participants with Treatment-emergent Adverse Events (TEAEs)",
          "timeFrame": "Day 1 through Week 16"
        }
      ],
      "secondaryOutcomes": [
        {
          "measure": "Part A: Mean Change From Baseline in Critical Temperature Threshold (CTT) at Week 12",
          "description": "CTT is the temperature at which CIndU symptoms appear.",
          "timeFrame": "Baseline, Week 12"
        },
        {
          "measure": "Part A: Mean Change From Baseline in Total Fric Score (TFS) at Week 12",
          "description": "TFS is a measure of CIndU trigger thresholds and disease activity.",
          "timeFrame": "Baseline, Week 12"
        },
        {
          "measure": "Part A and Part B: Complete Response Rate",
          "timeFrame": "Week 12"
        },
        {
          "measure": "Part A and Part B: Absolute Change From Baseline in Serum Tryptase Concentration at Week 12",
          "timeFrame": "Baseline, Week 12"
        },
        {
          "measure": "Part A and Part B: Percent Change From Baseline in Serum Tryptase Concentration at Week 12",
          "timeFrame": "Baseline, Week 12"
        },
        {
          "measure": "Part A and Part B: Area Under the Curve (AUC) of BLU-808",
          "timeFrame": "Day 1 to Day 57"
        },
        {
          "measure": "Part A and Part B: Maximum Plasma Concentration (Cmax) of BLU-808",
          "timeFrame": "Day 1 to Day 57"
        },
        {
          "measure": "Part A and Part B: Minimum Plasma Concentration (Cmin) of BLU-808",
          "timeFrame": "Day 1 to Day 57"
        },
        {
          "measure": "Part A and Part B: Apparent Clearance (CL/F) of BLU-808",
          "timeFrame": "Day 1 to Day 57"
        },
        {
