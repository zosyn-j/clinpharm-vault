    "outcomesModule": {
      "primaryOutcomes": [
        {
          "measure": "Safety and tolerability",
          "description": "Safety will be assessed through an evaluation of treatment emergent adverse events, physical exams, vital signs, laboratory tests, and 12-lead ECGs.",
          "timeFrame": "Day 1 to Week 6"
        }
      ],
      "secondaryOutcomes": [
        {
          "measure": "Change in Total Fric Score (TFS)",
          "description": "Changes in the number of prongs that elicit a wheal response using a FricTest for subjects with symptomatic dermographism.",
          "timeFrame": "Day 1 to Week 4"
        },
        {
          "measure": "Change in Critical Temperature Threshold (CTT)",
          "description": "Changes in the highest temperature that elicits a wheal response using a TempTest for subjects with cold urticaria.",
          "timeFrame": "Day 1 to Week 4"
        },
        {
          "measure": "Change in pruritus severity at the provocation test site",
          "description": "Changes in the severity of pruritus at the provocation test site using an 11-point numerical rating scale.",
          "timeFrame": "Day 1 to Week 4"
        }
      ]
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\n* Confirmed diagnosis of chronic inducible urticaria for at least 3 months.\n* Positive response following provocation using the TempTest or FricTest at Screening and Day 1.\n\nExclusion Criteria:\n\n* History of diseases other than chronic inducible urticaria or chronic spontaneous urticaria with urticaria or angioedema symptoms, such as urticarial vasculitis, erythema multiforme, cutaneous mastocytosis (urticaria pigmentosa), and hereditary or acquired angioedema.\n* Concurrent use of certain medications, including antihistamines.\n* Any clinically significant disease, or other skin disease or skin markings (e.g., extensive scarring, tattoos), that might confound the evaluation of safety or efficacy.",
      "healthyVolunteers": false,
      "sex": "ALL",
      "minimumAge": "18 Years",
      "maximumAge": "65 Years",
      "stdAges": [
        "ADULT",
        "OLDER_ADULT"
      ]
    },
