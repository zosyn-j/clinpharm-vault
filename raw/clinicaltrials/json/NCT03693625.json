    "descriptionModule": {
      "briefSummary": "This is a Phase II, multicenter, open-label extension (OLE) study to evaluate the long-term safety and efficacy of fenebrutinib in participants with Chronic Spontaneous Urticaria (CSU) who have completed the treatment period in a fenebrutinib CSU parent study. Participants may enroll in this OLE study at any time after completing the treatment period of the parent study. Participants will receive open-label fenebrutinib at a dose of 200 milligram (mg) orally twice a day. Treatment may continue until the end of the study."
    },
    "conditionsModule": {
      "conditions": [
        "Urticaria"
      ]
    },
